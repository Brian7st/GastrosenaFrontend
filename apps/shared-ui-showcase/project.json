{
  "name": "shared-ui-showcase",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/shared-ui-showcase/src",
  "tags": ["scope:shared", "type:app", "type:ui-showcase"],
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "options": {
        "outputPath": "dist/apps/shared-ui-showcase",
        "index": "apps/shared-ui-showcase/src/index.html",
        "browser": "apps/shared-ui-showcase/src/main.ts",
        "polyfills": ["zone.js"],
        "tsConfig": "apps/shared-ui-showcase/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "assets": [],
        "styles": ["apps/shared-ui-showcase/src/styles.scss"]
      },
      "configurations": {
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        },
        "production": {
          "outputHashing": "all"
        }
      },
      "defaultConfiguration": "production"
    },
    "serve": {
      "executor": "@angular/build:dev-server",
      "options": {
        "buildTarget": "shared-ui-showcase:build:development"
      }
    }
  }
}
