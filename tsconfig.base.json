{
  "compileOnSave": false,
  "compilerOptions": {
    "baseUrl": ".",
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2022",
    "module": "ES2022",
    "lib": ["ES2022", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "paths": {
      "@restaurant/feature-shell": ["libs/shell/feature-shell/src/index.ts"],
      "@restaurant/feature-home": ["libs/shell/feature-home/src/index.ts"],
      "@restaurant/feature-auth": ["libs/auth/feature-auth/src/index.ts"],
      "@restaurant/feature-usuarios": ["libs/auth/feature-usuarios/src/index.ts"],
      "@restaurant/feature-cocina": ["libs/cocina/feature-cocina/src/index.ts"],
      "@restaurant/feature-bar": ["libs/bar/feature-bar/src/index.ts"],
      "@restaurant/feature-restaurante": ["libs/restaurante/feature-restaurante/src/index.ts"],
      "@restaurant/feature-inventario": ["libs/inventario/feature-inventario/src/index.ts"],
      "@restaurant/feature-abastecimiento": ["libs/abastecimiento/feature-abastecimiento/src/index.ts"],
      "@restaurant/feature-facturacion": ["libs/facturacion/feature-facturacion/src/index.ts"],
      "@restaurant/feature-presupuesto": ["libs/presupuesto/feature-presupuesto/src/index.ts"],
      "@restaurant/feature-requisiciones": ["libs/requisiciones/feature-requisiciones/src/index.ts"],
      "@restaurant/feature-reportes": ["libs/reportes/feature-reportes/src/index.ts"],
      "@restaurant/feature-notificaciones": ["libs/notificaciones/feature-notificaciones/src/index.ts"],
      "@restaurant/shared/auth": ["libs/shared/auth/src/index.ts"],
      "@restaurant/shared/api": ["libs/shared/api/src/index.ts"],
      "@restaurant/shared/state": ["libs/shared/state/src/index.ts"],
      "@restaurant/shared/ui": ["libs/shared/ui/src/index.ts"],
      "@restaurant/shared/models": ["libs/shared/models/src/index.ts"],
      "@restaurant/shared/util": ["libs/shared/util/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
